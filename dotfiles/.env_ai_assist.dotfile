# --- managed-by-dotfiles ---
# configurations for local assistants
export CLAUDE_CODE_USE_VERTEX=1
export CLOUD_ML_REGION=global
export ANTHROPIC_VERTEX_PROJECT_ID=itpc-gcp-pnd-pe-eng-claude
# Goose uses different env var names for the same GCP Vertex config
export GCP_PROJECT_ID="${ANTHROPIC_VERTEX_PROJECT_ID}"
export GCP_LOCATION="${CLOUD_ML_REGION}"
# Load AGENTS.md or CLAUDE.md as context if no .goosehints present
export CONTEXT_FILE_NAMES='["AGENTS.md", ".goosehints", "CLAUDE.md"]'
# --- end-managed ---
