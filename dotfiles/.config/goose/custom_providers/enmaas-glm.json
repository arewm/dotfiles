{
  "name": "enmaas-glm",
  "engine": "anthropic",
  "display_name": "EnMaaS GLM 5.3 (thinking variants)",
  "description": "GLM 5.3 on EnMaaS with per-effort model aliases: glm-5-3-low / glm-5-3-high / glm-5-3-max, all resolving to rits/zai-org/glm-5-3",
  "api_key_env": "ENMAAS_KEY",
  "base_url": "https://api.enmaas.devshift.net",
  "dynamic_models": false,
  "models": [
    {
      "name": "glm-5-3-low",
      "resolved_model": "rits/zai-org/glm-5-3",
      "context_limit": 1048576,
      "auto_compact_token_limit": 800000,
      "request_params": {"reasoning_effort": "low"}
    },
    {
      "name": "glm-5-3-high",
      "resolved_model": "rits/zai-org/glm-5-3",
      "context_limit": 1048576,
      "auto_compact_token_limit": 800000,
      "request_params": {"reasoning_effort": "high"}
    },
    {
      "name": "glm-5-3-max",
      "resolved_model": "rits/zai-org/glm-5-3",
      "context_limit": 1048576,
      "auto_compact_token_limit": 800000,
      "request_params": {"reasoning_effort": "max"}
    }
  ],
  "supports_streaming": true,
  "requires_auth": true
}
